{
  "name": "minerails-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 0.0.0.0 --port 32000",
    "build": "npm run generate-api && npm run check-dsl-types && npm run validate-models && npm run copy-reference-files && npm run build:site && npm run index-search",
    "build:site": "docusaurus build",
    "generate-api": "../gradlew -p .. dokkaGeneratePublicationHtml --quiet",
    "prepare-search": "node scripts/mark-search-content.mjs",
    "index-search": "npm run prepare-search && pagefind",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --host 0.0.0.0 --port 32000",
    "typecheck": "tsc",
    "check-examples": "node scripts/check-examples.mjs",
    "check-loader": "../gradlew -p .. :BukkitPlugin:test --quiet",
    "check-dsl-types": "tsc --project ../types/tsconfig.json",
    "validate-models": "node scripts/validate-model-packages.mjs",
    "copy-reference-files": "node scripts/copy-reference-files.mjs",
    "check": "npm run typecheck && npm run check-examples && npm run check-loader && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "ajv": "8.20.0",
    "pagefind": "1.5.2",
    "typescript": "~6.0.2",
    "yaml": "2.9.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.7"
  }
}
