{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-v1.schema.json",
  "title": "JavaRailways train control v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config-version",
    "max-speed",
    "controller",
    "traction",
    "brake",
    "resistance",
    "adhesion",
    "jerk"
  ],
  "properties": {
    "config-version": {"const": 1},
    "max-speed": {"type": "number", "minimum": 0},
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power-notches", "brake-notches"],
      "properties": {
        "power-notches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "brake-notches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "traction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notch-scales"],
      "properties": {
        "notch-scales": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "brake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notch-scales", "apply-time", "release-time"],
      "properties": {
        "notch-scales": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "apply-time": {"type": "number", "minimum": 0},
        "release-time": {"type": "number", "minimum": 0}
      }
    },
    "resistance": {"$ref": "#/$defs/resistance"},
    "adhesion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficient"],
      "properties": {
        "coefficient": {"type": "number", "minimum": 0}
      }
    },
    "jerk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traction", "brake"],
      "properties": {
        "traction": {"type": "number", "minimum": 0},
        "brake": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "resistance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c"],
      "properties": {
        "a": {"type": "number", "minimum": 0},
        "b": {"type": "number", "minimum": 0},
        "c": {"type": "number", "minimum": 0}
      }
    }
  }
}
