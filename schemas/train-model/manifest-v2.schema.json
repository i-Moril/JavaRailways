{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-v2.schema.json",
  "title": "JavaRailways package manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["config-version", "name", "type"],
  "properties": {
    "config-version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "type": {"type": "string", "enum": ["train", "rail"]},
    "display-name": {"type": "string"},
    "composition": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "rail-config": {"type": "string", "minLength": 1},
    "extensions": {
      "type": "object",
      "propertyNames": {"$ref": "model-common.schema.json#/$defs/extensionTypeId"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["directory"],
        "properties": {
          "directory": {
            "type": "string", "minLength": 1,
            "pattern": "^(?!/)(?=[^\\u0000]*\\S)(?![A-Za-z]:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*/$(?![\\s\\S]))[^\\u0000\\\\]+$(?![\\s\\S])"
          },
          "schema-version": {"type": "integer", "minimum": 1, "default": 1}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "train"},
        "composition": {"type": "array"},
        "rail-config": false
      },
      "required": ["type", "composition"]
    },
    {
      "properties": {
        "type": {"const": "rail"},
        "composition": false,
        "extensions": false,
        "rail-config": {"type": "string"}
      },
      "required": ["type", "rail-config"]
    }
  ]
}
