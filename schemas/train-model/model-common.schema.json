{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-common.schema.json",
  "title": "JavaRailways train model common definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "brightness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {"type": "integer"},
        "sky": {"type": "integer"}
      }
    },
    "animationCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": {"type": "number", "default": 0.0},
        "offset": {"$ref": "#/$defs/vector"},
        "rotation": {"$ref": "#/$defs/vector"},
        "scale": {"$ref": "#/$defs/scale"},
        "scene": {"type": "string"},
        "item-type": {"type": "string"},
        "item-model": {"type": "string"},
        "custom-model-data": {"type": "integer"},
        "brightness": {"$ref": "#/$defs/brightness"}
      }
    },
    "animationKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": {"type": "number"},
        "scene": {"type": "string"},
        "offset": {"$ref": "#/$defs/vector"},
        "rotation": {"$ref": "#/$defs/vector"},
        "scale": {"$ref": "#/$defs/scale"},
        "item-type": {"type": "string"},
        "item-model": {"type": "string"},
        "custom-model-data": {"type": "integer"},
        "brightness": {"$ref": "#/$defs/brightness"}
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep-final-state": {"type": "boolean", "default": true},
        "commands": {
          "type": "array",
          "items": {"$ref": "#/$defs/animationCommand"}
        },
        "keyframes": {
          "type": "array",
          "items": {"$ref": "#/$defs/animationKeyframe"}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [
        {
          "properties": {"item-model": {"$ref": "#/$defs/nonEmptyString"}},
          "required": ["item-model"]
        },
        {
          "properties": {"custom-model-data": {"type": "integer"}},
          "required": ["custom-model-data"]
        }
      ],
      "properties": {
        "type": {"$ref": "#/$defs/nonEmptyString"},
        "item-model": {"$ref": "#/$defs/nonEmptyString"},
        "custom-model-data": {"type": "integer"},
        "scale": {"$ref": "#/$defs/scale"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "number", "default": 1.0},
        "height": {"type": "number", "default": 1.0},
        "driver": {"type": "boolean", "default": false},
        "control-end": {
          "type": "string",
          "enum": ["head", "front", "f", "tail", "rear", "back", "r"]
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rows": {"type": "integer", "minimum": 1, "default": 1},
        "columns": {"type": "integer", "minimum": 1, "default": 1},
        "spacing-x": {"type": "number"},
        "spacing-z": {"type": "number"},
        "spacing": {"$ref": "#/$defs/vector"}
      }
    },
    "extensionTypeId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$(?![\\s\\S])"
    },
    "partContent": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "type": {
          "type": "string",
          "oneOf": [
            {"enum": ["dummy", "item_display", "interact", "seat", "platform"]},
            {"$ref": "#/$defs/extensionTypeId"}
          ]
        },
        "item": {"$ref": "#/$defs/item"},
        "interaction": {"$ref": "#/$defs/interaction"},
        "platform": {"$ref": "#/$defs/platform"},
        "config": {"type": "object", "description": "Opaque extension-owned configuration; its provider validates fields."},
        "schema-version": {"type": "integer", "minimum": 1, "default": 1},
        "offset": {"$ref": "#/$defs/vector"},
        "rotation": {"$ref": "#/$defs/vector"},
        "parts": {
          "type": "array",
          "items": {"$ref": "#/$defs/partReference"}
        },
        "animations": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "\\S"},
          "additionalProperties": {"$ref": "#/$defs/animation"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "item_display"}}},
          "then": {
            "properties": {"item": {"$ref": "#/$defs/item"}},
            "required": ["item"]
          }
        },
        {
          "if": {"properties": {"type": {"$ref": "#/$defs/extensionTypeId"}}, "required": ["type"]},
          "then": {
            "required": ["config"],
            "properties": {"item": false, "interaction": false, "platform": false}
          },
          "else": {"properties": {"config": false, "schema-version": false}}
        }
      ]
    },
    "partDefinition": {
      "description": "Standalone part document; nested parts inherit this version.",
      "allOf": [{"$ref": "#/$defs/partContent"}],
      "required": ["config-version"],
      "properties": {"config-version": {"const": 1}},
      "unevaluatedProperties": false
    },
    "inlinePartDefinition": {
      "description": "Inline part content inherits the containing document version.",
      "allOf": [{"$ref": "#/$defs/partContent"}],
      "unevaluatedProperties": false
    },
    "importReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import"],
      "properties": {
        "import": {"$ref": "#/$defs/nonEmptyString"},
        "offset": {"$ref": "#/$defs/vector"},
        "rotation": {"$ref": "#/$defs/vector"}
      }
    },
    "partReference": {
      "oneOf": [
        {"$ref": "#/$defs/importReference"},
        {"$ref": "#/$defs/inlinePartDefinition"}
      ]
    }
  }
}
